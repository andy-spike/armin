{
  "name": "armin-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Armin web and Expo mobile applications, Convex backend, and shared study code.",
  "homepage": "https://github.com/andy-spike/armin#readme",
  "bugs": {
    "url": "https://github.com/andy-spike/armin/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andy-spike/armin.git"
  },
  "scripts": {
    "dev": "node packages/backend/scripts/start-dev.mjs all",
    "dev:setup": "pnpm --filter @armin/backend dev:setup",
    "dev:web": "node packages/backend/scripts/start-dev.mjs web",
    "dev:backend": "node packages/backend/scripts/start-dev.mjs backend",
    "dev:mobile": "node packages/backend/scripts/start-dev.mjs mobile",
    "dev:android": "node packages/backend/scripts/start-dev.mjs android",
    "dev:ios": "node packages/backend/scripts/start-dev.mjs ios",
    "check": "vp check",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "plugin:package": "node scripts/package-plugin.mjs",
    "anki:kit": "node scripts/build-anki-kit.mjs",
    "anki:kit:verify": "node scripts/build-anki-kit.mjs --verify",
    "worktree:setup": "node scripts/setup-worktree.mjs",
    "worktree:seed": "pnpm --filter @armin/backend worktree:seed"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.1"
}
