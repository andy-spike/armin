# Production values for `pnpm --filter @armin/web deploy` (vite build --mode
# cloudflare). These are public: the browser receives them. They take priority
# over .env.local, so a deploy from any checkout targets production.
VITE_CONVEX_URL=https://intent-bullfrog-922.convex.cloud
VITE_CONVEX_SITE_URL=https://intent-bullfrog-922.convex.site
VITE_SITE_URL=https://armincards.app
