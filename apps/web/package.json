{
  "name": "@armin/web",
  "version": "0.0.0",
  "private": true,
  "description": "Armin web app: TanStack Start client and auth/media/export proxy for the Convex backend.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/build-anki-kit.mjs",
    "dev": "vp dev",
    "prebuild": "node ../../scripts/build-anki-kit.mjs",
    "build": "vp build",
    "start": "vp preview --port 3000 --strictPort",
    "build:node": "node ../../scripts/build-anki-kit.mjs && vp build --mode node",
    "start:node": "node node-server.mjs",
    "build:cloudflare": "node ../../scripts/build-anki-kit.mjs && vp build --mode cloudflare",
    "preview:cloudflare": "pnpm build:cloudflare && vp preview --mode cloudflare",
    "deploy": "pnpm build:cloudflare && wrangler deploy",
    "landing:clips": "node scripts/record-landing-clips.mjs"
  },
  "dependencies": {
    "@armin/backend": "workspace:*",
    "@armin/core": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/better-auth": "0.12.7",
    "@convex-dev/react-query": "0.1.0",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/markdown": "^1.2.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@tanstack/redact": "0.2.6",
    "@xyflow/react": "^12.12.1",
    "better-auth": "1.6.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.49.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.71.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.160.0"
  }
}
