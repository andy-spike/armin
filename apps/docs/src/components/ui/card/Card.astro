---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  title?: string;
  icon?: string;
  href?: string;
}

const { title, icon, href, class: className, ...attrs } = Astro.props;
const hasIcon = Boolean(icon) || Astro.slots.has("icon");
const hasTitle = Boolean(title) || Astro.slots.has("title");
const Tag = href ? "a" : "article";
const Title = href ? "p" : "h3";
---

<Tag
  data-slot="card"
  href={href}
  class={cn(
    "my-4 block rounded-lg bg-card p-5 shadow-sm ring ring-border",
    href && "group text-inherit no-underline transition-[box-shadow] hover:shadow-default hover:ring-border-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
    className,
  )}
  {...attrs}
>
  {hasIcon && (
    <div data-slot="card-icon" class="mb-2.5 text-brand">
      <slot name="icon">{icon && <Icon name={icon} class="block size-6" />}</slot>
    </div>
  )}
  {hasTitle && (
    <Title data-slot="card-title" class={cn("m-0 text-base font-semibold leading-snug text-foreground", href && "transition-colors group-hover:text-primary")}>
      <slot name="title">{title}</slot>
    </Title>
  )}
  <div data-slot="card-content" class:list={["text-sm leading-normal text-muted-foreground", hasTitle && "mt-1.5"]}>
    <slot />
  </div>
</Tag>
