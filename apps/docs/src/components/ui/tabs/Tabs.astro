---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import TabsList from "./TabsList.astro";

interface Props extends HTMLAttributes<"div"> {
  syncKey?: string;
}

const { syncKey, class: className, ...attrs } = Astro.props;

const content = await Astro.slots.render("default");
const list = content.search(/\sdata-nb-tabs-list\b/);
const item = content.search(/\sdata-nb-tab-label\b/);
const manual = list !== -1 && (item === -1 || list < item);
---

<div
  data-nb-tabs
  data-slot="tabs"
  data-nb-sync-key={syncKey}
  class={cn(className)}
  {...attrs}
>
  {manual ? (
    <Fragment set:html={content} />
  ) : (
    <Fragment>
      <TabsList />
      <div class="mt-3">
        <Fragment set:html={content} />
      </div>
    </Fragment>
  )}
</div>

<script>
  import "./tabs.client";
</script>
