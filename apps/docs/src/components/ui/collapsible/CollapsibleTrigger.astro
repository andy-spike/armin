---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {}

const { class: className, type, "data-slot": slot = "collapsible-trigger", ...attrs } = Astro.props;
---

<button
  data-slot={slot}
  type={type ?? "button"}
  data-nb-collapsible-trigger
  class={cn("w-full text-start cursor-pointer select-none", className)}
  {...attrs}
>
  <slot />
</button>
