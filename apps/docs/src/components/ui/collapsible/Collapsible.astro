---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  open?: boolean;
}

const { open = false, class: className, "data-slot": slot = "collapsible", ...attrs } = Astro.props;
---

<div
  data-slot={slot}
  data-nb-collapsible
  data-nb-default-open={open ? "true" : undefined}
  class={cn(className)}
  {...attrs}
>
  <slot />
</div>

<script>
  import "./collapsible.client";
</script>
