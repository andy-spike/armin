---
import { cn } from "@/lib/cn";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import type { HTMLAttributes } from "astro/types";
import {
  buttonVariants,
  buttonIconSize,
  type ButtonVariant,
  type ButtonSize,
  type ButtonShape,
} from "../button/variants";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: ButtonVariant | "minimal";
  size?: ButtonSize | "md";
  shape?: ButtonShape;
  icon?: boolean;
}

const {
  href,
  variant = "primary",
  size = "md",
  shape = "base",
  icon = false,
  class: className,
  ...attrs
} = Astro.props;

const resolvedVariant: ButtonVariant = variant === "minimal" ? "ghost" : variant;
const resolvedSize: ButtonSize = size === "md" ? "base" : size;
---

<a
  data-slot="button"
  data-variant={resolvedVariant}
  href={href}
  class={cn(
    buttonVariants({ variant: resolvedVariant, size: resolvedSize, shape }),
    className,
  )}
  {...attrs}
>
  <slot />
  {
    icon && (
      <Icon
        name="ph:caret-right"
        class={cn(
          "transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5",
          buttonIconSize[resolvedSize],
        )}
       
      />
    )
  }
</a>
