---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  orientation?: "vertical" | "horizontal";
}

const { orientation = "vertical", class: className, "data-slot": slot = "layer-card", ...attrs } = Astro.props;
---

<div
  data-slot={slot}
  data-orientation={orientation}
  class={cn(
    "group/layer flex w-full overflow-hidden rounded-lg bg-muted text-sm ring ring-border",
    orientation === "horizontal" ? "flex-row items-stretch" : "flex-col",
    className,
  )}
  {...attrs}
>
  <slot />
</div>
