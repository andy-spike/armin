---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  markdownUrl?: string;
  lastUpdated?: Date;
}

const { markdownUrl, lastUpdated, class: className, ...attrs } = Astro.props;
const resolvedMarkdownUrl = markdownUrl
  ? withBase(markdownUrl, import.meta.env.BASE_URL)
  : undefined;

const baseBtn =
  "inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-transparent px-2 py-1 text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2";

const extra = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

const absoluteMarkdownUrl =
  resolvedMarkdownUrl && Astro.site ? new URL(resolvedMarkdownUrl, Astro.site).href : undefined;
const assistantPrompt = absoluteMarkdownUrl
  ? `Read ${absoluteMarkdownUrl} so I can ask questions about it. It is a page of the Armin docs, a spaced-repetition flashcard app.`
  : undefined;
const assistants = assistantPrompt
  ? [
      {
        label: "ChatGPT",
        href: `https://chatgpt.com/?hints=search&q=${encodeURIComponent(assistantPrompt)}`,
        icon: "ph:open-ai-logo",
      },
      {
        label: "Claude",
        href: `https://claude.ai/new?q=${encodeURIComponent(assistantPrompt)}`,
        icon: "ph:chat-circle-dots",
      },
    ]
  : [];

const formattedDate = lastUpdated
  ? new Intl.DateTimeFormat(undefined, { year: "numeric", month: "short", day: "numeric" }).format(lastUpdated)
  : null;
---

{(markdownUrl || lastUpdated || extra) && (
  <div
    data-nb-page-actions
    data-slot="page-actions"
    data-pagefind-ignore
    data-md-url={resolvedMarkdownUrl}
    class={cn("not-prose -ms-2 flex flex-wrap items-center gap-x-1 gap-y-1 text-[0.8125rem] leading-5", className)}
    {...attrs}
  >
    {lastUpdated && (
      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-muted-foreground">
        <Icon name="ph:clock" class="w-3.5 h-3.5" />
        <span class="sr-only sm:not-sr-only">Updated</span> <time datetime={lastUpdated.toISOString()}>{formattedDate}</time>
      </span>
    )}

    {markdownUrl && (
      <>
        <button type="button" data-nb-page-actions-copy class={baseBtn}>
          <Icon name="ph:copy" class="w-3.5 h-3.5" data-nb-page-actions-copy-icon />
          <Icon name="ph:check" class="hidden w-3.5 h-3.5 text-success" data-nb-page-actions-check-icon />
          <span data-nb-page-actions-label aria-live="polite">Copy page</span>
        </button>

        <a
          href={resolvedMarkdownUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View as Markdown"
          class={baseBtn}
        >
          <Icon name="ph:markdown-logo" class="w-3.5 h-3.5" />
          <span aria-hidden="true">Markdown</span>
        </a>

        {assistants.map((assistant) => (
            <a
              href={assistant.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ask ${assistant.label} about this page (opens a new tab)`}
              data-nb-page-actions-assistant={assistant.label.toLowerCase()}
              class={baseBtn}
            >
              <Icon name={assistant.icon} class="w-3.5 h-3.5" />
              <span class="sm:hidden" aria-hidden="true">{assistant.label}</span>
              <span class="hidden sm:inline" aria-hidden="true">Ask {assistant.label}</span>
            </a>
        ))}
      </>
    )}
    {extra && <Fragment set:html={extra} />}
  </div>
)}

<script>
  import "./page-actions.client";
</script>
