{
  "name": "@armin/mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@armin/core": "workspace:*",
    "expo": "~57.0.28",
    "expo-crypto": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.7",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "typecheck": "tsc --noEmit",
    "check:bundle": "expo export --platform android --platform ios",
    "check:expo": "expo-doctor"
  },
  "private": true,
  "license": "MIT",
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  }
}
