# Settings for a self-hosted Armin instance. selfhost/setup.sh creates
# selfhost/.env from this file and fills in what it can. Keep .env private and
# back it up: it holds the secrets that unlock your data.

# --- Required: you choose these -------------------------------------------
# The address you open Armin at. Point DNS for it, api.<it>, and actions.<it>
# at this server (see https://docs.armincards.app/guides/self-hosting/).
ARMIN_DOMAIN=
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=

# --- Optional ----------------------------------------------------------------
# Other addresses for the Convex API and HTTP actions. Defaults: api.<domain>
# and actions.<domain>.
ARMIN_API_DOMAIN=
ARMIN_ACTIONS_DOMAIN=
# Ports Caddy listens on. Change only if 80/443 are taken; HTTPS on another
# port puts it in every address (https://cards.example.com:8443).
HTTP_PORT=80
HTTPS_PORT=443
# How many daily backups selfhost/backup.sh keeps.
BACKUP_KEEP=7
# Concept cards generate practice exercises with a model through the Vercel AI
# Gateway, billed to your own gateway account. Set both to turn them on: an
# API key from https://vercel.com/ai-gateway and a model ID in creator/model
# form, such as openai/gpt-5-mini. Leave either empty to keep them off.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# --- Generated by setup.sh: don't edit ---------------------------------------
SITE_URL=
CONVEX_CLOUD_ORIGIN=
CONVEX_SITE_ORIGIN=
INSTANCE_SECRET=
BETTER_AUTH_SECRET=
CONVEX_ADMIN_KEY=
